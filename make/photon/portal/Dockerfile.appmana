FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS portal
WORKDIR /build_dir
COPY api/v2.0/swagger.yaml ./swagger.yaml
COPY src/portal ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-optional --no-audit --no-fund
RUN npm run postinstall && npm run generate-build-timestamp
RUN node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration production
FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS trust-check
COPY make/photon/common/verify-trust.go /src/verify-trust.go
RUN CGO_ENABLED=0 go build -o /verify-trust /src/verify-trust.go
FROM goharbor/harbor-portal:v2.15.4@sha256:01edf478505b21dba23a83c095f6ecac0c1e705690093edbab41e9a4d6754a75
USER root
RUN tdnf upgrade -y && tdnf clean all
COPY --from=trust-check /verify-trust /tmp/verify-trust
RUN /tmp/verify-trust /etc/pki/tls/certs/ca-bundle.crt && rm /tmp/verify-trust
USER nginx
COPY --from=portal /build_dir/dist /usr/share/nginx/html
