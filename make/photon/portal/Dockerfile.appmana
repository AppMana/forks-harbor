FROM node:22.22.3-bookworm-slim AS portal
WORKDIR /build_dir
COPY api/v2.0/swagger.yaml ./swagger.yaml
COPY src/portal ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-optional --no-audit --no-fund
RUN npm run postinstall && npm run generate-build-timestamp
RUN node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration production
FROM goharbor/harbor-portal:v2.15.2
COPY --from=portal /build_dir/dist /usr/share/nginx/html
